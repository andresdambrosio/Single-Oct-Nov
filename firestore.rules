rules_version = '2';

// Reglas de Firestore para Tini Tennis Tour.
// Copiar en Consola de Firebase → Firestore → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Opcional: limitar el acceso a los participantes. Descomentar y sumar `&& allowed()` en signedIn().
    // function allowed() {
    //   return request.auth.token.email in ['andresdambrosio@gmail.com', 'otro@gmail.com'];
    // }

    // Perfil público: nombre y foto de Google. Cada uno escribe sólo el suyo.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
    }

    // Apuestas: todos los logueados las ven; cada uno crea las suyas y no se pueden editar ni borrar.
    // El id es <uid>_<partido>_<mercado> (o <uid>_champion), así hay una sola apuesta por mercado.
    match /bets/{betId} {
      allow read: if signedIn();
      allow update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'matchId', 'market', 'pick', 'odds', 'stake', 'title', 'desc', 'placedAt'])
        && request.resource.data.market in ['winner', 'score', 'champion']
        && (
          (request.resource.data.market == 'champion' && betId == request.auth.uid + '_champion')
          || betId == request.auth.uid + '_' + request.resource.data.matchId + '_' + request.resource.data.market
        )
        && request.resource.data.stake is int
        && request.resource.data.stake > 0 && request.resource.data.stake <= 1000
        && request.resource.data.odds is number
        && request.resource.data.odds >= 1.0 && request.resource.data.odds <= 250
        && request.resource.data.placedAt == request.time;
    }
  }
}
